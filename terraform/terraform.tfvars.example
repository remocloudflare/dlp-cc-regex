# Copy to terraform.tfvars (gitignored) and fill in real values.

# --- required, per-deployment ---
cloudflare_api_token  = "REPLACE_WITH_TOKEN"   # Account Zero Trust · Edit + Workers Scripts · Edit
cloudflare_account_id = "REPLACE_WITH_ACCOUNT_ID"

# --- optional overrides (defaults live in variables.tf) ---
# name_prefix = "remo"

# Serve the frontend at a custom hostname (SAFE per-hostname route + proxied AAAA;
# does NOT touch other Workers on the zone). Leave both "" for script-only.
# worker_hostname = "dlp-regex.itlinux.cc"
# zone_id         = "REPLACE_WITH_ZONE_ID"

# Deploy toggles (foundation = DLP profile + Worker; Gateway enforcement is opt-in)
# deploy_worker       = true
# deploy_dlp_profile  = true
# deploy_gateway_rule = false   # flip true to enforce; needs TLS inspection ON

# Gateway enforcement tuning (only used when deploy_gateway_rule = true)
# gateway_rule_action = "allow"   # "allow" to monitor first, then "block"
# gateway_payload_log = false     # true requires an X25519 key in DLP settings

# Custom DLP entries. Build/test in the Worker frontend, paste the generated
# object here. validation "luhn" adds a credit-card checksum; "none" = structural.
# dlp_custom_entries = [
#   {
#     name       = "CC 13-19 digits, loose separators"
#     regex      = "\\b\\d(?:[ -]?\\d){12,18}\\b"
#     validation = "luhn"
#   },
# ]
